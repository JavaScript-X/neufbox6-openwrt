CONFIG_TARGET_bmips=y
CONFIG_TARGET_bmips_bcm6362=y
CONFIG_TARGET_bmips_bcm6362_DEVICE_sfr_neufbox-6-sercomm-r0=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_kmod-switch-rtl8367=y
CONFIG_PACKAGE_kmod-b43=y
CONFIG_PACKAGE_broadcom-6362-sprom=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_B43_PHY_N=y
# CONFIG_B43_FW_5_100_138 is not set
CONFIG_B43_FW_DSL_3580L=y
CONFIG_B43_FW_SQUASH_COREREVS="22"
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-sensors=y
CONFIG_PACKAGE_collectd-mod-uptime=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-ttyd=y
