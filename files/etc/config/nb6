# SFR Neufbox 6 port settings (read by /usr/sbin/nb6-leds)

config leds 'leds'
	# brightness of the Internet, VPN and System LEDs: 1..31
	option brightness '31'
	# night mode: dim the ring LEDs between night_start and night_end (HH:MM, may cross midnight)
	option night '0'
	option night_start '23:00'
	option night_end '07:00'
	option night_brightness '4'

config eco 'eco'
	# eco mode, switched by the ECO button; the state survives a reboot
	option enabled '0'
	# ring LED brightness in eco mode (1..31)
	option led_brightness '4'
	# 1 = keep the white traffic LEDs (wan, wlan) blinking
	option traffic_leds '0'
	# 1 = pause statistics (collectd) and per-device traffic (nlbwmon)
	option pause_stats '1'
	# 1 = also turn the Wi-Fi off
	option wifi_off '0'
