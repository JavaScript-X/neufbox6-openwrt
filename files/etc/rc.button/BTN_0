#!/bin/sh
# SFR button (BTN_0): toggle the "spiral" animation of LEDs a/b/c (see /usr/sbin/nb6-leds)
[ "$ACTION" = released ] || exit 0

STATE=/tmp/nb6-leds
mkdir -p $STATE
if [ -e $STATE/spiral ]; then
	rm -f $STATE/spiral
	logger -t nb6-buttons "SFR button: LEDs back to status mode"
else
	touch $STATE/spiral
	logger -t nb6-buttons "SFR button: LED spiral mode"
fi
return 0
