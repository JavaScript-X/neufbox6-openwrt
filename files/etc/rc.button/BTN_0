#!/bin/sh
# SFR button (BTN_0): VPN
#   short press          tailnet tunnel (interface "vpn") on / off
#   long press (>= 3 s)  commercial VPN (interface "vpn_commercial") on / off
# LED b shows the result (see /usr/sbin/nb6-leds). Set the tunnels up with nb6-vpn.
[ "$ACTION" = released ] || exit 0

if [ "${SEEN:-0}" -ge 3 ]; then IF=vpn_commercial; NAME="commercial VPN"; else IF=vpn; NAME="tailnet VPN"; fi

configured() {
	[ "$(uci -q get network.$1.proto)" = wireguard ] || return 1
	[ -n "$(uci -q show network | grep "=wireguard_$1\$")" ] || return 1
	[ -n "$(uci -q get network.$1.private_key)" ]
}

if ! configured $IF; then
	logger -t nb6-buttons "ECO button: $NAME not configured (see nb6-vpn)"
	# 3 red flashes on LED b
	for i in 1 2 3; do
		echo 31 > /sys/class/leds/red:service2/brightness; sleep 1
		echo 0 > /sys/class/leds/red:service2/brightness; sleep 1
	done
	return 0
fi

if [ "$(uci -q get network.$IF.disabled)" = 1 ]; then
	uci set network.$IF.disabled=0
	uci commit network
	ifup $IF
	logger -t nb6-buttons "ECO button: $NAME on"
else
	uci set network.$IF.disabled=1
	uci commit network
	ifdown $IF
	logger -t nb6-buttons "ECO button: $NAME off"
fi
return 0
