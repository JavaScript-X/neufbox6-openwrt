#!/bin/sh
# ECO button (BTN_1): turn the VPN interface on/off (UCI network interface "vpn", e.g. WireGuard).
# LED b shows the result (see /usr/sbin/nb6-leds).
[ "$ACTION" = released ] || exit 0

VPN_IF=vpn
if ! uci -q get network.$VPN_IF >/dev/null; then
	logger -t nb6-buttons "ECO button: no '$VPN_IF' interface configured"
	# 3 short red flashes on LED b
	for i in 1 2 3; do
		echo 31 > /sys/class/leds/red:service2/brightness; sleep 1
		echo 0 > /sys/class/leds/red:service2/brightness; sleep 1
	done
	return 0
fi

if [ "$(uci -q get network.$VPN_IF.disabled)" = 1 ]; then
	uci set network.$VPN_IF.disabled=0
	uci commit network
	ifup $VPN_IF
	logger -t nb6-buttons "ECO button: VPN on"
else
	uci set network.$VPN_IF.disabled=1
	uci commit network
	ifdown $VPN_IF
	logger -t nb6-buttons "ECO button: VPN off"
fi
return 0
