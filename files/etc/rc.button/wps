#!/bin/sh
# Wi-Fi switch pushed past "on" (KEY_WPS_BUTTON, GPIO 25): WPS push-button pairing for 2 minutes.
# The white wlan LED blinks (500 ms) while WPS is open: faster blinking floods the I2C LED controller.
# hostapd in OpenWrt 25.12 is driven over ubus (no per-interface control sockets).
[ "$ACTION" = released ] || exit 0

LED=/sys/class/leds/white:wlan
done_any=0
for obj in $(ubus -S list 'hostapd.*'); do
	ubus -S call "$obj" wps_start >/dev/null 2>&1 && done_any=1
done

if [ $done_any = 1 ]; then
	logger -t nb6-buttons "WPS: pairing open for 120 s"
	echo timer > $LED/trigger
	echo 500 > $LED/delay_on; echo 500 > $LED/delay_off
	( sleep 120; /etc/init.d/led restart ) &
else
	logger -t nb6-buttons "WPS: no hostapd interface accepted wps_start"
fi
return 0
