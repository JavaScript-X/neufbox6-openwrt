#!/bin/sh
# Ad blocking (LuCI > Neufbox > Ad blocking): adblock-fast with only Peter Lowe's ad server list
# (about 3 500 domains, ~1.5 MB for dnsmasq). Bigger lists (Hagezi Light, 90 000 domains, ~6 MB)
# got dnsmasq killed for lack of memory under load on this 64 MB box. Off until turned on in LuCI. DNS is not forced
# so that the tailnet and commercial VPN keep their own resolvers.
uci -q get adblock-fast.config >/dev/null || exit 0
# first install only: uci-defaults run again after each upgrade, and the user's choice must stay
uci -q get adblock-fast.nb6pgl >/dev/null && exit 0
for s in $(uci -q show adblock-fast | sed -n 's/^adblock-fast\.\([^.=]*\)=file_url$/\1/p'); do
	uci set adblock-fast.$s.enabled=0
done
uci -q delete adblock-fast.nb6pgl
uci set adblock-fast.nb6pgl=file_url
uci set adblock-fast.nb6pgl.name="Peter Lowe's ad servers"
uci set adblock-fast.nb6pgl.url='https://pgl.yoyo.org/adservers/serverlist.php?hostformat=nohtml&showintro=0&mimetype=plaintext'
uci set adblock-fast.nb6pgl.action='block'
uci set adblock-fast.nb6pgl.enabled='1'
uci set adblock-fast.config.force_dns='0'
uci set adblock-fast.config.enabled='0'
uci commit adblock-fast
/etc/init.d/adblock-fast disable 2>/dev/null
exit 0
