#!/bin/sh
# rpcd backend for the LuCI "Neufbox" pages (Home, Devices, Wi-Fi and guests, VPN, LEDs, backup).
# Private keys are never returned: only public keys and tunnel status.

. /usr/share/libubox/jshn.sh

b() { [ "$1" = 1 ] && echo true || echo false; }

tunnel_json() { # $1 = interface -> one JSON object on stdout
	local i=$1 st up pending dev ep hs rx tx now age conf en
	[ "$(uci -q get network.$i.proto)" = wireguard ] && [ -n "$(uci -q get network.$i.private_key)" ] && conf=1 || conf=0
	[ "$(uci -q get network.$i.disabled)" = 1 ] && en=0 || en=1
	st=$(ifstatus $i 2>/dev/null)
	up=$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)
	pending=$(echo "$st" | jsonfilter -e '@.pending' 2>/dev/null)
	dev=$(echo "$st" | jsonfilter -e '@.l3_device' 2>/dev/null)
	ep=""; age=-1; rx=0; tx=0
	if [ "$up" = true ]; then
		# peer line of "wg show <dev> dump": pubkey psk endpoint allowed-ips handshake rx tx keepalive
		set -- $(wg show ${dev:-$i} dump 2>/dev/null | sed -n 2p)
		ep=$3; hs=${5:-0}; rx=${6:-0}; tx=${7:-0}
		now=$(date +%s)
		[ "$hs" -gt 0 ] 2>/dev/null && age=$((now - hs))
	fi
	[ "$up" = true ] && up=1 || up=0
	[ "$pending" = true ] && pending=1 || pending=0
	printf '{"configured":%s,"enabled":%s,"up":%s,"pending":%s,' $(b $conf) $(b $en) $(b $up) $(b $pending)
	printf '"endpoint":"%s","handshake_age":%s,"rx_bytes":%s,"tx_bytes":%s}' "$ep" "$age" "$rx" "$tx"
}

tunnel_word() { # $1 = interface -> unconfigured | off | connecting | up
	local i=$1 st dev hs
	{ [ "$(uci -q get network.$i.proto)" = wireguard ] && [ -n "$(uci -q get network.$i.private_key)" ]; } || { echo unconfigured; return; }
	[ "$(uci -q get network.$i.disabled)" = 1 ] && { echo off; return; }
	st=$(ifstatus $i 2>/dev/null)
	[ "$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)" = true ] || { echo connecting; return; }
	dev=$(echo "$st" | jsonfilter -e '@.l3_device' 2>/dev/null)
	hs=$(wg show ${dev:-$i} latest-handshakes 2>/dev/null | awk '{print $2}' | sort -n | tail -1)
	[ -n "$hs" ] && [ "$hs" -gt 0 ] && [ $(( $(date +%s) - hs )) -lt 180 ] && echo up || echo connecting
}

home_json() {
	local st w6 lan=0 p link t v u n
	json_init

	# LED states published by nb6-leds: "internet vpn system" (green/orange/red/off/connecting/both/error)
	set -- $(cat /tmp/nb6-leds.state 2>/dev/null)
	json_add_object leds
	json_add_string internet "${1:-off}"; json_add_string vpn "${2:-off}"; json_add_string system "${3:-off}"
	json_close_object

	st=$(ifstatus wan 2>/dev/null)
	w6=$(ifstatus wan6 2>/dev/null)
	json_add_object wan
	json_add_string internet "${1:-unknown}"
	json_add_string proto "$(uci -q get network.wan.proto)"
	json_add_string link "$(swconfig dev switch0 port 0 get link 2>/dev/null | sed -n 's/.*speed:\([0-9]*\)baseT.*/\1/p')"
	json_add_string ipv4 "$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
	json_add_string ipv6 "$(echo "$w6" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)"
	u=$(echo "$st" | jsonfilter -e '@.uptime' 2>/dev/null); json_add_int uptime "${u:-0}"
	json_close_object

	json_add_object box
	json_add_string model "$(cat /tmp/sysinfo/model 2>/dev/null)"
	json_add_string release "$(cat /etc/nb6-release 2>/dev/null)"
	json_add_string openwrt "$(. /etc/openwrt_release; echo "$DISTRIB_DESCRIPTION")"
	json_add_string kernel "$(uname -r)"
	json_add_int uptime "$(cut -d. -f1 /proc/uptime)"
	t=$(cat /sys/class/hwmon/hwmon*/temp1_input 2>/dev/null | head -1); json_add_int temperature "${t:-0}"
	v=$(cat /sys/class/hwmon/hwmon*/in0_input 2>/dev/null | head -1); json_add_int voltage "${v:-0}"
	json_add_int mem_total "$(awk '/MemTotal/{print $2}' /proc/meminfo)"
	json_add_int mem_available "$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
	json_add_boolean eco "$([ "$(uci -q get nb6.eco.enabled)" = 1 ] && echo 1 || echo 0)"
	json_close_object

	json_add_object vpn
	json_add_string tailnet "$(tunnel_word vpn)"
	json_add_string commercial "$(tunnel_word vpn_commercial)"
	json_add_string provider "$(uci -q get network.vpn_commercial_peer.provider)"
	json_close_object

	# one swconfig call for the four LAN ports (1-4); port 0 is the WAN
	lan=$(swconfig dev switch0 show 2>/dev/null | grep -cE 'link: port:[1-4] link:up')
	json_add_object devices
	json_add_int lan_ports "$lan"
	json_add_int wifi_clients "$(iw dev phy0-ap0 station dump 2>/dev/null | grep -c '^Station')"
	json_add_string ssid "$(iw dev phy0-ap0 info 2>/dev/null | sed -n 's/^\s*ssid //p')"
	n=$(grep -c . /tmp/dhcp.leases 2>/dev/null); json_add_int leases "${n:-0}"
	json_close_object
	json_dump
}


strip() { tr -d '"\\001-\037'; }	# safe inside a JSON string

devices_json() {
	local first mac ip name exp st sec
	printf '{"leases":['
	first=1
	while read -r exp mac ip name _; do
		[ -n "$mac" ] || continue
		[ $first = 1 ] || printf ','; first=0
		printf '{"mac":"%s","ip":"%s","name":"%s","expires":%s}' "$mac" "$ip" "$(echo "$name" | strip)" "${exp:-0}"
	done < /tmp/dhcp.leases 2>/dev/null
	printf '],"neigh":['
	# home and guest networks; a line per neighbour: ip mac state network
	for d in br-lan br-guest; do ip -4 neigh show dev $d 2>/dev/null | sed "s/\$/ $d/"; done | awk '
		$2 == "lladdr" { printf "%s{\"ip\":\"%s\",\"mac\":\"%s\",\"state\":\"%s\",\"guest\":%s}", (n++ ? "," : ""), $1, $3, $4, ($NF == "br-guest" ? "true" : "false") }'
	printf '],"wifi":['
	{ iw dev phy0-ap0 station dump; echo "GUEST"; iw dev phy0-ap0-guest station dump; } 2>/dev/null | awk '
		/^GUEST/ { if (mac) out(); mac = ""; g = 1 }
		/^Station/ { if (mac) out(); mac = $2; sig = ""; ct = 0 }
		/signal:/ && !/avg/ { sig = $2 }
		/connected time:/ { ct = $3 }
		function out() { printf "%s{\"mac\":\"%s\",\"signal\":%s,\"connected\":%s,\"guest\":%s}", (n++ ? "," : ""), mac, (sig == "" ? "null" : sig), ct, (g ? "true" : "false") }
		END { if (mac) out() }'
	printf '],"traffic":'
	nlbw -c json -g mac 2>/dev/null || printf 'null'
	printf ',"rules":['
	first=1
	for sec in $(uci -q show firewall | sed -n 's/^firewall\.\(nb6_block_[0-9a-f]*\)=rule$/\1/p'); do
		[ $first = 1 ] || printf ','; first=0
		printf '{"mac":"%s","start":"%s","stop":"%s","days":"%s"}' \
			"$(uci -q get firewall.$sec.src_mac)" "$(uci -q get firewall.$sec.start_time)" \
			"$(uci -q get firewall.$sec.stop_time)" "$(uci -q get firewall.$sec.weekdays)"
	done
	printf '],"hosts":['
	first=1
	for sec in $(uci -q show dhcp | sed -n 's/^dhcp\.\([^.=]*\)=host$/\1/p'); do
		[ -n "$(uci -q get dhcp.$sec.mac)" ] || continue
		[ $first = 1 ] || printf ','; first=0
		printf '{"mac":"%s","name":"%s","ip":"%s"}' "$(uci -q get dhcp.$sec.mac | tr 'A-F' 'a-f')" \
			"$(uci -q get dhcp.$sec.name | strip)" "$(uci -q get dhcp.$sec.ip)"
	done
	printf ']}\n'
}

valid_mac() { echo "$1" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; }

device_access() { # mac mode(allow|block|schedule) start stop days name
	local mac=$(echo "$1" | tr 'A-F' 'a-f') sec
	valid_mac "$mac" || { echo '{"error":"invalid MAC address"}'; return; }
	sec=nb6_block_$(echo "$mac" | tr -d ':')
	uci -q delete firewall.$sec
	case "$2" in
	block|schedule)
		uci set firewall.$sec=rule
		uci set firewall.$sec.name="Neufbox: no internet for $(echo "${6:-$mac}" | strip)"
		uci set firewall.$sec.src=lan
		uci set firewall.$sec.dest='*'
		uci set firewall.$sec.src_mac="$mac"
		uci set firewall.$sec.proto=all
		uci set firewall.$sec.target=REJECT
		if [ "$2" = schedule ]; then
			echo "$3$4" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]([01][0-9]|2[0-3]):[0-5][0-9]$' \
				|| { uci revert firewall; echo '{"error":"invalid time"}'; return; }
			uci set firewall.$sec.start_time="$3:00"
			uci set firewall.$sec.stop_time="$4:00"
			[ -n "$5" ] && uci set firewall.$sec.weekdays="$(echo "$5" | tr -cd 'A-Za-z ')"
		fi ;;
	esac
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	echo '{"ok":true}'
}

adblock_json() {
	local f=/var/run/adblock-fast/dnsmasq.servers n=0 t=0
	[ -s $f ] && { n=$(grep -c . $f); t=$(date -r $f +%s); }
	printf '{"installed":%s,"enabled":%s,"domains":%s,"updated":%s,"busy":%s}\n' \
		"$([ -x /etc/init.d/adblock-fast ] && echo true || echo false)" \
		"$([ "$(uci -q get adblock-fast.config.enabled)" = 1 ] && echo true || echo false)" \
		"$n" "$t" "$([ -e /tmp/nb6-adblock.busy ] && echo true || echo false)"
}

adblock_bg() { # run an adblock-fast action in the background (it downloads and restarts dnsmasq)
	( touch /tmp/nb6-adblock.busy; /etc/init.d/adblock-fast "$@" >/dev/null 2>&1; rm -f /tmp/nb6-adblock.busy ) &
}

wifi_json() {
	local enc en
	enc=$(uci -q get wireless.default_radio0.encryption)
	{ [ "$(uci -q get wireless.radio0.disabled)" = 1 ] || [ "$(uci -q get wireless.default_radio0.disabled)" = 1 ]; } && en=0 || en=1
	json_init
	json_add_boolean enabled $en
	json_add_string ssid "$(uci -q get wireless.default_radio0.ssid)"
	json_add_string key "$(uci -q get wireless.default_radio0.key)"
	json_add_string encryption "${enc:-none}"
	json_add_string channel "$(uci -q get wireless.radio0.channel)"
	json_add_int clients "$(iw dev phy0-ap0 station dump 2>/dev/null | grep -c '^Station')"
	json_dump
}

wifi_set() { # ssid key enabled
	local enc=$(uci -q get wireless.default_radio0.encryption)
	if [ "$3" = 0 ]; then
		uci set wireless.default_radio0.disabled=1
	else
		{ [ ${#1} -ge 1 ] && [ ${#1} -le 32 ] && ! printf '%s' "$1" | grep -q '[[:cntrl:]]'; } \
			|| { echo '{"error":"the Wi-Fi name needs 1 to 32 characters"}'; return; }
		if [ "${enc:-none}" != none ]; then
			{ [ ${#2} -ge 8 ] && [ ${#2} -le 63 ] && ! printf '%s' "$2" | grep -q '[^ -~]'; } \
				|| { echo '{"error":"the Wi-Fi password needs 8 to 63 characters (letters, digits, symbols)"}'; return; }
			{ [ "$(uci -q get nb6.guest.enabled)" = 1 ] && [ "$2" = "$(uci -q get nb6.guest.key)" ]; } \
				&& { echo '{"error":"the Wi-Fi password must differ from the guest password"}'; return; }
			uci set wireless.default_radio0.key="$2"
		fi
		uci set wireless.default_radio0.ssid="$1"
		uci -q delete wireless.default_radio0.disabled
		uci set wireless.radio0.disabled=0
	fi
	uci commit wireless
	# in the background: the reply goes out before the Wi-Fi restarts
	( sleep 1; wifi reload ) >/dev/null 2>&1 &
	echo '{"ok":true}'
}

net_of() { # address, netmask or prefix length -> network address
	case "$2" in *.*) ipcalc.sh "$1" "$2" ;; *) ipcalc.sh "$1/$2" ;; esac | sed -n 's/^NETWORK=//p'
}

host_set() { # mac name ip -> fixed address and name (dhcp host nb6_host_<mac>)
	local mac=$(echo "$1" | tr 'A-F' 'a-f') name ip=$3 sec s lan mask
	valid_mac "$mac" || { echo '{"error":"invalid MAC address"}'; return; }
	name=$(printf '%s' "$2" | tr ' _' '--' | tr -cd 'A-Za-z0-9-' | cut -c1-63)
	sec=nb6_host_$(echo "$mac" | tr -d ':')
	if [ -n "$ip" ]; then
		echo "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || { echo '{"error":"invalid IP address"}'; return; }
		lan=$(uci -q get network.lan.ipaddr); mask=$(uci -q get network.lan.netmask)
		case "$lan" in */*) mask=${lan#*/}; lan=${lan%/*} ;; esac
		[ "$(net_of "$ip" "${mask:-24}")" = "$(net_of "$lan" "${mask:-24}")" ] \
			|| { echo '{"error":"the address must be in the local network"}'; return; }
		[ "$ip" != "$lan" ] || { echo '{"error":"this is the address of the box"}'; return; }
		for s in $(uci -q show dhcp | sed -n 's/^dhcp\.\([^.=]*\)=host$/\1/p'); do
			[ "$s" != "$sec" ] && [ "$(uci -q get dhcp.$s.ip)" = "$ip" ] \
				&& { echo '{"error":"this address is already given to another device"}'; return; }
		done
	fi
	uci -q delete dhcp.$sec
	if [ -n "$name" ] || [ -n "$ip" ]; then
		uci set dhcp.$sec=host
		uci set dhcp.$sec.mac="$mac"
		[ -n "$name" ] && uci set dhcp.$sec.name="$name"
		[ -n "$ip" ] && uci set dhcp.$sec.ip="$ip"
	fi
	uci commit dhcp
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
	echo '{"ok":true}'
}

backup_json() { # flash partitions, with the checksums of the two that are unique to each box
	local dev size name
	json_init
	json_add_array parts
	while read -r dev size _ name; do
		case "$dev" in mtd*:) ;; *) continue ;; esac
		name=$(echo "$name" | tr -d '"')
		json_add_object
		json_add_string name "$name"
		json_add_int size $((0x$size))
		case "$name" in cfe|nvram) json_add_string sha256 "$(sha256sum /dev/${dev%:} | cut -d' ' -f1)" ;; esac
		json_close_object
	done < /proc/mtd
	json_close_array
	json_dump
}

case "$1" in
list)
	cat <<'EOF'
{ "status": {}, "home": {}, "pubkey": {}, "rekey": {}, "init": {}, "set_tunnel": { "iface": "str", "enabled": true }, "eco": { "enabled": true }, "import_commercial": { "private_key": "str", "addresses": "str", "dns": "str", "public_key": "str", "preshared_key": "str", "endpoint_host": "str", "endpoint_port": "str", "provider": "str" }, "devices": {}, "device_access": { "mac": "str", "mode": "str", "start": "str", "stop": "str", "days": "str", "name": "str" }, "device_wake": { "mac": "str" }, "adblock_status": {}, "adblock_set": { "enabled": true }, "adblock_update": {}, "update_check": { "force": true }, "update_install": {}, "update_status": {}, "wifi": {}, "wifi_set": { "ssid": "str", "key": "str", "enabled": true }, "guest": {}, "guest_set": { "enabled": true, "key": "str", "port4": true }, "host_set": { "mac": "str", "name": "str", "ip": "str" }, "backup_info": {} }
EOF
	;;
call)
	case "$2" in
	status)
		uci -q get network.vpn >/dev/null && init=1 || init=0
		[ "$(uci -q get nb6.eco.enabled)" = 1 ] && eco=1 || eco=0
		echo "{\"initialized\":$(b $init),\"eco\":$(b $eco),\"vpn\":$(tunnel_json vpn),\"vpn_commercial\":$(tunnel_json vpn_commercial)}"
		;;
	home)
		# several open pages poll this every 10 s: answer from an 8 s cache
		C=/tmp/luci-nb6-home.json
		if [ -s $C ] && [ $(( $(date +%s) - $(date -r $C +%s) )) -lt 8 ]; then
			cat $C
		else
			home_json > $C.$$ && mv $C.$$ $C && cat $C
		fi
		;;
	devices)
		devices_json
		;;
	device_access)
		read -r input; json_load "$input"
		json_get_var mac mac; json_get_var mode mode; json_get_var start start
		json_get_var stop stop; json_get_var days days; json_get_var name name
		device_access "$mac" "$mode" "$start" "$stop" "$days" "$name"
		;;
	device_wake)
		read -r input; json_load "$input"; json_get_var mac mac
		if valid_mac "$mac" && etherwake -i br-lan "$mac" >/dev/null 2>&1; then echo '{"ok":true}'; else echo '{"error":"wake failed"}'; fi
		;;
	adblock_status)
		adblock_json
		;;
	adblock_set)
		read -r input; json_load "$input"; json_get_var enabled enabled
		if [ "$enabled" = 1 ]; then
			uci set adblock-fast.config.enabled=1; uci commit adblock-fast
			/etc/init.d/adblock-fast enable; adblock_bg start
		else
			uci set adblock-fast.config.enabled=0; uci commit adblock-fast
			/etc/init.d/adblock-fast disable; adblock_bg stop
		fi
		echo '{"ok":true}'
		;;
	adblock_update)
		adblock_bg dl
		echo '{"ok":true}'
		;;
	update_check)
		read -r input; json_load "$input"; json_get_var force force
		/usr/sbin/nb6-update check "$([ "$force" = 1 ] && echo force)"
		;;
	update_install)
		/usr/sbin/nb6-update install
		;;
	update_status)
		/usr/sbin/nb6-update status
		;;
	wifi)
		wifi_json
		;;
	wifi_set)
		read -r input; json_load "$input"
		json_get_var ssid ssid; json_get_var key key; json_get_var enabled enabled
		wifi_set "$ssid" "$key" "${enabled:-1}"
		;;
	guest)
		/usr/sbin/nb6-guest status
		;;
	guest_set)
		read -r input; json_load "$input"
		json_get_var enabled enabled; json_get_var key key; json_get_var port4 port4
		if [ "$enabled" = 1 ]; then
			err=$(/usr/sbin/nb6-guest on "$key" $([ "$port4" = 1 ] && echo port4) 2>&1 >/dev/null)
		else
			err=$(/usr/sbin/nb6-guest off 2>&1 >/dev/null)
		fi
		json_init
		if [ -n "$err" ]; then json_add_string error "$err"; else json_add_boolean ok 1; fi
		json_dump
		;;
	host_set)
		read -r input; json_load "$input"
		json_get_var mac mac; json_get_var name name; json_get_var ip ip
		host_set "$mac" "$name" "$ip"
		;;
	backup_info)
		backup_json
		;;
	pubkey)
		json_init
		k=$(uci -q get network.vpn.private_key)
		json_add_string pubkey "$([ -n "$k" ] && echo "$k" | wg pubkey)"
		json_dump
		;;
	rekey)
		json_init
		if uci -q get network.vpn >/dev/null; then
			uci set network.vpn.private_key="$(wg genkey)"
			uci commit network
			[ "$(uci -q get network.vpn.disabled)" = 1 ] || ifup vpn
			json_add_string pubkey "$(uci get network.vpn.private_key | wg pubkey)"
		else
			json_add_string error "not initialized"
		fi
		json_dump
		;;
	init)
		json_init
		/usr/sbin/nb6-vpn init >/dev/null 2>&1
		k=$(uci -q get network.vpn.private_key)
		json_add_string pubkey "$([ -n "$k" ] && echo "$k" | wg pubkey)"
		json_dump
		;;
	set_tunnel)
		read -r input
		json_load "$input"
		json_get_var iface iface
		json_get_var enabled enabled
		json_init
		case "$iface" in
		vpn|vpn_commercial)
			if [ "$enabled" = 1 ]; then
				uci set network.$iface.disabled=0; uci commit network; ifup $iface
			else
				uci set network.$iface.disabled=1; uci commit network; ifdown $iface
			fi
			json_add_boolean ok 1 ;;
		*) json_add_string error "unknown interface" ;;
		esac
		json_dump
		;;
	import_commercial)
		# fields parsed by the LuCI page from the provider's WireGuard file
		read -r input
		json_load "$input"
		for v in private_key addresses dns public_key preshared_key endpoint_host endpoint_port provider; do
			json_get_var $v $v
		done
		json_init
		if [ -z "$private_key" ] || [ -z "$public_key" ] || [ -z "$endpoint_host" ] || [ -z "$addresses" ]; then
			json_add_string error "missing PrivateKey, Address, PublicKey or Endpoint"
			json_dump
			exit 0
		fi
		uci -q get network.vpn_commercial >/dev/null || /usr/sbin/nb6-vpn init >/dev/null 2>&1
		uci set network.vpn_commercial.private_key="$private_key"
		uci -q delete network.vpn_commercial.addresses
		for a in $addresses; do uci add_list network.vpn_commercial.addresses="$a"; done
		uci -q delete network.vpn_commercial.dns
		for d in $dns; do uci add_list network.vpn_commercial.dns="$d"; done
		[ -n "$dns" ] && uci set network.vpn_commercial.peerdns=0
		uci -q get network.vpn_commercial_peer >/dev/null || uci set network.vpn_commercial_peer=wireguard_vpn_commercial
		uci set network.vpn_commercial_peer.description=provider
		case "$provider" in
			mullvad|protonvpn|nordvpn|surfshark|expressvpn|privateinternetaccess|cloudflare)
				uci set network.vpn_commercial_peer.provider="$provider" ;;
			*) uci -q delete network.vpn_commercial_peer.provider ;;
		esac
		uci set network.vpn_commercial_peer.public_key="$public_key"
		if [ -n "$preshared_key" ]; then
			uci set network.vpn_commercial_peer.preshared_key="$preshared_key"
		else
			uci -q delete network.vpn_commercial_peer.preshared_key
		fi
		uci set network.vpn_commercial_peer.endpoint_host="$endpoint_host"
		uci set network.vpn_commercial_peer.endpoint_port="${endpoint_port:-51820}"
		uci -q delete network.vpn_commercial_peer.allowed_ips
		uci add_list network.vpn_commercial_peer.allowed_ips=0.0.0.0/1
		uci add_list network.vpn_commercial_peer.allowed_ips=128.0.0.0/1
		case "$addresses" in *:*)	# IPv6 address from the provider: route IPv6 through the tunnel too
			uci add_list network.vpn_commercial_peer.allowed_ips=::/1
			uci add_list network.vpn_commercial_peer.allowed_ips=8000::/1 ;;
		esac
		uci set network.vpn_commercial_peer.route_allowed_ips=1
		uci set network.vpn_commercial_peer.persistent_keepalive=25
		uci commit network
		[ "$(uci -q get network.vpn_commercial.disabled)" = 1 ] || ifup vpn_commercial
		json_add_boolean ok 1
		json_dump
		;;
	eco)
		read -r input
		json_load "$input"
		json_get_var enabled enabled
		[ "$enabled" = 1 ] && /usr/sbin/nb6-eco on || /usr/sbin/nb6-eco off
		json_init
		json_add_boolean ok 1
		json_dump
		;;
	esac
	;;
esac
