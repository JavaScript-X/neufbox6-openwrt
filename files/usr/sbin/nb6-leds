#!/bin/sh
# SFR Neufbox 6 front LEDs daemon (OpenWrt port)
#
#  LED a (service1): Internet  green = OK, orange = WAN link up but no internet, red = WAN cable unplugged
#  LED b (service2): VPN       green = up, orange blinking = connecting, off = down / not configured
#  LED c (service3): health    green = OK, orange = hot or low memory, red blinking = error
#  LED voip (white): blinks for 60 s when a new device gets a DHCP lease on the LAN
#
#  "spiral" mode (toggled by the SFR button): a/b/c cycle green -> orange -> red, one step apart.
#
# State: /tmp/nb6-leds/spiral exists = spiral mode.

L=/sys/class/leds
STATE=/tmp/nb6-leds
KNOWN=/etc/nb6-leds.known-macs
VPN_IF=${VPN_IF:-vpn}
WAN_PORT=0
PING_HOST=1.1.1.1
TEMP_WARN=70000          # milli-degrees C
MEM_WARN_KB=4096

mkdir -p $STATE
# first start: devices already on the LAN are not "new"
[ -s $KNOWN ] || awk '{print $2}' /tmp/dhcp.leases 2>/dev/null > $KNOWN

# brightness 0..31; orange = red + some green
color() { # $1 = 1|2|3  $2 = green|orange|red|off
	case "$2" in
		green)  r=0;  g=31 ;;
		orange) r=31; g=10 ;;
		red)    r=31; g=0 ;;
		*)      r=0;  g=0 ;;
	esac
	echo $r > $L/red:service$1/brightness 2>/dev/null
	echo $g > $L/green:service$1/brightness 2>/dev/null
}

internet_state() {
	link=$(swconfig dev switch0 port $WAN_PORT get link 2>/dev/null)
	case "$link" in *link:up*) ;; *) echo red; return ;; esac
	if [ $((tick % 10)) -eq 0 ] || [ -z "$net_ok" ]; then
		ping -c1 -W2 $PING_HOST >/dev/null 2>&1 && net_ok=1 || net_ok=0
	fi
	[ "$net_ok" = 1 ] && echo green || echo orange
}

vpn_state() {
	uci -q get network.$VPN_IF >/dev/null || { echo off; return; }
	up=$(ifstatus $VPN_IF 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
	[ "$up" = "true" ] || {
		# interface asked up but not up yet = connecting
		[ "$(uci -q get network.$VPN_IF.disabled)" = 1 ] && { echo off; return; }
		pending=$(ifstatus $VPN_IF 2>/dev/null | jsonfilter -e '@.pending' 2>/dev/null)
		[ "$pending" = "true" ] && echo connecting || echo off
		return
	}
	if [ "$(uci -q get network.$VPN_IF.proto)" = wireguard ]; then
		dev=$(ifstatus $VPN_IF | jsonfilter -e '@.l3_device' 2>/dev/null)
		last=$(wg show ${dev:-$VPN_IF} latest-handshakes 2>/dev/null | awk '{print $2}' | sort -n | tail -1)
		now=$(date +%s)
		[ -n "$last" ] && [ "$last" -gt 0 ] && [ $((now - last)) -lt 180 ] && echo green || echo connecting
	else
		echo green
	fi
}

health_state() {
	err=0
	pidof dnsmasq >/dev/null || err=1
	pidof netifd >/dev/null || err=1
	[ "$(df /overlay 2>/dev/null | awk 'NR==2{print $4}')" -lt 200 ] 2>/dev/null && err=1
	[ $err = 1 ] && { echo error; return; }
	t=$(cat /sys/class/hwmon/hwmon*/temperature 2>/dev/null | head -1)
	m=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
	if { [ -n "$t" ] && [ "$t" -gt $TEMP_WARN ]; } || [ "${m:-99999}" -lt $MEM_WARN_KB ]; then
		echo orange
	else
		echo green
	fi
}

new_device_check() {
	[ -f /tmp/dhcp.leases ] || return
	for mac in $(awk '{print $2}' /tmp/dhcp.leases); do
		grep -q -x "$mac" $KNOWN && continue
		echo "$mac" >> $KNOWN
		voip_until=$(( $(date +%s) + 60 ))
		logger -t nb6-leds "new device on LAN: $mac"
	done
}

blink() { [ $((tick % 2)) -eq 0 ] && echo "$1" || echo off; }

spiral_step=0
spiral() {
	set -- green orange red
	for led in 1 2 3; do
		i=$(( (spiral_step + led - 1) % 3 ))
		case $i in 0) c=green ;; 1) c=orange ;; 2) c=red ;; esac
		color $led $c
	done
	spiral_step=$(( (spiral_step + 1) % 3 ))
}

# first run: take over the LEDs from the microcontroller's own animation
for led in 1 2 3; do color $led off; done
voip_until=0
tick=0
while true; do
	if [ -e $STATE/spiral ]; then
		spiral
		sleep 1
		continue
	fi

	color 1 $(internet_state)
	case $(vpn_state) in
		green)      color 2 green ;;
		connecting) color 2 $(blink orange) ;;
		*)          color 2 off ;;
	esac
	case $(health_state) in
		error) color 3 $(blink red) ;;
		*)     color 3 $(health_state) ;;
	esac

	[ $((tick % 5)) -eq 0 ] && new_device_check
	if [ "$(date +%s)" -lt "$voip_until" ]; then
		[ $((tick % 2)) -eq 0 ] && echo 31 > $L/white:voip/brightness || echo 0 > $L/white:voip/brightness
	else
		echo 0 > $L/white:voip/brightness 2>/dev/null
	fi

	tick=$((tick + 1))
	sleep 1
done
