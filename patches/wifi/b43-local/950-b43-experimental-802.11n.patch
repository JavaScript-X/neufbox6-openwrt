+/*
+ * 802.11n (HT), one spatial stream, 20 MHz, long guard interval: data rate in kbit/s and
+ * the PHY control byte (modulation and coding rate) of MCS 0-7, from brcmsmac's mcs_table.
+ */
+static const struct {
+	u16 kbps;
+	u8 phy_ctl3;
+} b43_ht_mcs[8] = {
+	{ 6500, 0x00 }, { 13000, 0x08 }, { 19500, 0x0A }, { 26000, 0x10 },
+	{ 39000, 0x12 }, { 52000, 0x19 }, { 58500, 0x1A }, { 65000, 0x1C },
+};
+
+/* HT-SIG of a mixed-mode frame (brcmsmac brcms_c_compute_mimo_plcp) */
+static void b43_generate_ht_plcp(struct b43_plcp_hdr6 *plcp, u16 octets, u8 mcs)
+{
+	memset(plcp->raw, 0, sizeof(plcp->raw));
+	plcp->raw[0] = mcs;			/* MCS, 20 MHz */
+	plcp->raw[1] = octets & 0xff;		/* HT length */
+	plcp->raw[2] = (octets >> 8) & 0xff;
+	plcp->raw[3] = 0x07;			/* smoothing, not sounding, reserved */
+}
+
+/* L-SIG length of a mixed-mode HT frame (brcmsmac brcms_c_calc_lsig_len, one stream) */
+static u16 b43_ht_lsig_len(u8 mcs, u16 octets)
+{
+	u32 kndbps = b43_ht_mcs[mcs].kbps * 4;
+	u32 nsyms = DIV_ROUND_UP((16 + 8 * octets + 6) * 1000, kndbps);
+
+	nsyms += 1 + 3;		/* streams, HT-SIG (2) and HT-STF (1) */
+	return 3 * nsyms - 3;
+}
+
+static u16 b43_generate_ht_phy_ctl1(u8 mcs)
+{
+	return B43_TXH_PHY1_BW_20 | B43_TXH_PHY1_MODE_SISO |
+	       (b43_ht_mcs[mcs].phy_ctl3 << 8);
+}
+
 /* Generate a TX data header. */
 int b43_generate_txhdr(struct b43_wldev *dev,
 		       u8 *_txhdr,
