From: JavaScript_X <73346071+JavaScript-X@users.noreply.github.com>
Subject: [PATCH] b43: experimental 802.11n (HT) rates on N-PHY

b43 only sends and receives 802.11b/g frames, also on N-PHY radios that can do
802.11n. This adds the minimum for HT on the BCM6362 (corerev 22, N-PHY rev 8,
radio 2057, v4 firmware 784):

- advertise HT on 2.4 GHz: MCS 0-7 (one stream), 20 MHz, long guard interval,
  no A-MPDU (b43 has no ampdu_action, mac80211 declines block-ack sessions);
- transmit: HT-SIG PLCP, HT frame type, PHY control word 1 (modulation and
  coding of the MCS) and mixed-mode L-SIG lengths for the main and fallback
  rates, as brcmsmac fills its d11txh (same layout as B43_FW_HDR_598);
- receive: decode HT frames (frame type 2/3) from the HT-SIG instead of
  dropping them as unknown CCK rates.

Module parameter ht=0 turns it off.

--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -94,6 +94,10 @@
 module_param_named(nohwcrypt, modparam_nohwcrypt, int, 0444);
 MODULE_PARM_DESC(nohwcrypt, "Disable hardware encryption.");
 
+static int modparam_ht = 1;
+module_param_named(ht, modparam_ht, int, 0444);
+MODULE_PARM_DESC(ht, "802.11n (HT) rates on N-PHY, 20 MHz, one stream (experimental, 0 = off)");
+
 static int modparam_hwtkip;
 module_param_named(hwtkip, modparam_hwtkip, int, 0444);
 MODULE_PARM_DESC(hwtkip, "Enable hardware tkip.");
@@ -5343,6 +5347,25 @@
 	if (have_2ghz_phy)
 		hw->wiphy->bands[NL80211_BAND_2GHZ] = limited_2g ?
 			&b43_band_2ghz_limited : &b43_band_2GHz;
+
+	/*
+	 * 802.11n, experimental: HT rates MCS 0-7 (one spatial stream), 20 MHz, long guard
+	 * interval, no aggregation (b43 has no A-MPDU support, so mac80211 declines block-ack
+	 * sessions). Transmit headers follow brcmsmac's d11txh, which has the same layout as
+	 * the v4 firmware header used here (B43_FW_HDR_598).
+	 */
+	if (have_2ghz_phy && modparam_ht && phy->type == B43_PHYTYPE_N) {
+		struct ieee80211_sta_ht_cap *ht =
+			&hw->wiphy->bands[NL80211_BAND_2GHZ]->ht_cap;
+
+		memset(ht, 0, sizeof(*ht));
+		ht->ht_supported = true;
+		ht->ampdu_factor = IEEE80211_HT_MAX_AMPDU_8K;
+		ht->ampdu_density = IEEE80211_HT_MPDU_DENSITY_NONE;
+		ht->mcs.rx_mask[0] = 0xff;
+		ht->mcs.tx_params = IEEE80211_HT_MCS_TX_DEFINED;
+		b43info(dev->wl, "802.11n (HT) enabled: MCS 0-7, 20 MHz (experimental)\n");
+	}
 	if (dev->phy.type == B43_PHYTYPE_N) {
 		if (have_5ghz_phy)
 			hw->wiphy->bands[NL80211_BAND_5GHZ] = limited_5g ?
--- a/drivers/net/wireless/broadcom/b43/xmit.c
+++ b/drivers/net/wireless/broadcom/b43/xmit.c
